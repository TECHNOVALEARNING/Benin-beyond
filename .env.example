# ==============================================================================
# BÉNIN BEYOND — EXEMPLE DE CONFIGURATION (.env.example)
# Copiez ce fichier vers .env et renseignez vos véritables clés d'API.
# ==============================================================================

# 1. Supabase (Base de données & Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Email Super-Administrateur
VITE_ADMIN_EMAIL=admin@beninbeyond.bj

# 3. Passerelle de Paiement Exclusive : Nyole (MTN MoMo, Moov Money, Celtiis, Wave, Carte)
# Aucune clé Nyole ici : la clé SECRÈTE (af_live_sec_...) se déclare uniquement dans
# Supabase > Edge Functions > Secrets (NYOLE_SECRET_KEY). Voir supabase/functions/DEPLOIEMENT.md

# 4. Authentification Google OAuth (Google Cloud Console + Supabase Auth Provider)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# 5. Coordonnées de contact
VITE_APP_URL=http://localhost:5173
VITE_SUPPORT_PHONE=+229 97 00 00 00
VITE_SUPPORT_EMAIL=contact@beninbeyond.bj
